{
  // Election Campaign OS: public site on Cloudflare Workers static assets (white paper ADR, option A).
  // Deploy: npm run build:site && npx wrangler deploy --config wrangler.site.jsonc
  // Needs the founder's decision on hosting (Workers vs Firebase) before first deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecos-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": { "directory": "./dist-site", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "electioncos.co.za", "custom_domain": true }]
}
