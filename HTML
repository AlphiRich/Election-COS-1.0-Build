<div class="ecos-card" style="max-width: 480px; margin: 0 auto;">
  <h3 class="ecos-card__title">Ward Ballot Support</h3>
  <p class="ecos-card__caption">Select the party emblem you intend to vote for tomorrow.</p>

  <div class="ecos-fields" style="margin-top: 24px; display: flex; flex-direction: column; gap: 16px;">
    
    <button class="ecos-tile" type="button" onclick="submitPoll('ANC')">
      <div class="ecos-tile__icon" style="background: transparent;">
        <img src="/assets/emblems/anc_logo.svg" alt="ANC Emblem" style="width: 100%; height: 100%; object-fit: contain;">
      </div>
      <div class="ecos-tile__title">African National Congress (ANC)</div>
    </button>

    <button class="ecos-tile" type="button" onclick="submitPoll('DA')">
      <div class="ecos-tile__icon" style="background: transparent;">
        <img src="/assets/emblems/da_logo.svg" alt="DA Emblem" style="width: 100%; height: 100%; object-fit: contain;">
      </div>
      <div class="ecos-tile__title">Democratic Alliance (DA)</div>
    </button>

    <button class="ecos-tile" type="button" onclick="submitPoll('FF+')">
      <div class="ecos-tile__icon" style="background: transparent;">
        <img src="/assets/emblems/ffplus_logo.svg" alt="FF+ Emblem" style="width: 100%; height: 100%; object-fit: contain;">
      </div>
      <div class="ecos-tile__title">Freedom Front Plus (FF+)</div>
    </button>

    <button class="ecos-tile" type="button" onclick="submitPoll('EFF')">
      <div class="ecos-tile__icon" style="background: transparent;">
        <img src="/assets/emblems/eff_logo.svg" alt="EFF Emblem" style="width: 100%; height: 100%; object-fit: contain;">
      </div>
      <div class="ecos-tile__title">Economic Freedom Fighters (EFF)</div>
    </button>

  </div>
</div>
